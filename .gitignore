# Словарь собирается скриптом и весит десятки мегабайт — в репозиторий не идёт.
Data/*.sqlite
Data/cache/

# Xcode
# Проект генерируется из App/project.yml — в репозиторий не идёт,
# иначе каждый xcodegen generate даёт конфликт на ровном месте.
*.xcodeproj/
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/
DerivedData/
build/
*.xcuserstate

# SwiftPM
Core/.build/
Core/.swiftpm/
.swiftpm/
Package.resolved

# macOS
.DS_Store

# Python
__pycache__/
*.pyc

# Скриншоты для App Store — снимаются заново, но пусть лежат: их просят на подаче.
# design/screenshots/ намеренно НЕ игнорируется.
